project: savantenvs/lci
target: lci-buggy-mhh-run-17
# origin: https://app.mayhem.security/mayhemheroes/lci/lci/17

cmds:
  # In-process libFuzzer harness over the lci LOLCODE pipeline -- scanBuffer ->
  # tokenizeLexemes -> parseMainNode -> interpretMainNodeScope (lexer, tokenizer,
  # parser, and the tree-walking VM/bindings) -- the same code path the archived
  # `lci @@` CLI drove on an input file, but instrumented (the raw CLI carried no
  # coverage -> 0 edges) and with the interpreter's host-facing primitives (file,
  # process, socket) neutered at build time. See mayhem/fuzz_lci.c and
  # mayhem/harness_stubs.c.
  - cmd: /mayhem/build/lci
    libfuzzer: true
    dictionary: /mayhem/mayhem/lci-buggy-mhh-run-17/lci.dict
    # Both values below are exactly what Mayhem's own auto-resolution selected on run #4
    # ("Auto-resolution managed to find Mayhemfile parameter values that resolve problems
    # ... { cmd.timeout: 30, cmd.env.MFUZZ_COMPAT_LEVEL: 2 }"), which the event log then asks
    # be set explicitly in the Mayhemfile. On run #4 Regression Testing smoketested SUCCESSFULLY
    # but Behavior Testing still failed its 5-iteration probe and the phase died a second after
    # auto-resolution proposed these, so they are pinned here rather than left to be rediscovered
    # each run.
    # 30s is generous on purpose: it only bounds a single exec, and it is the ONLY thing that
    # bounds an unbounded LOLCODE loop (`IM IN YR <loop>` with no reachable exit condition) --
    # the harness (mayhem/fuzz_lci.c) installs no timer/watchdog of its own; see that file's
    # header comment and docs/netnew-worker-prompt.md SS6b.
    timeout: 30
    env:
      MFUZZ_COMPAT_LEVEL: '2'
      # This backport's replay testsuite is the origin run's crashers (defects_only=true) -- every
      # entry reproduces the same bug, so Mayhem's pre-flight sanity smoke test ("at least one input
      # that doesn't result in a timeout or crash" in its first 5 iterations) fails outright and the
      # regression_testing task never starts (see run 2/3 events: "libFuzzer target failed to fuzz
      # for 5 iterations"). DISABLE_SMOKETEST skips that check; it does not affect the actual replay.
      DISABLE_SMOKETEST: '1'

testsuite:
  - https://$MAYHEM_DOMAIN/$MAYHEM_PROJECT/$MAYHEM_TARGET/testsuite.tar
